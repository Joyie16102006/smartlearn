# ============================================================
# SmartLearn AI Configuration
# ============================================================

# OPTION 1: NVIDIA NIM API (Recommended if you have an NVIDIA key)
# Get key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Choose any NVIDIA NIM model (default is meta/llama-3.3-70b-instruct):
# - meta/llama-3.3-70b-instruct (Fast, excellent at math, HDL, code)
# - deepseek-ai/deepseek-r1 (Unmatched step-by-step reasoning & math)
# - meta/llama-3.1-405b-instruct (Frontier massive model)
# - mistralai/mistral-large-2-instruct (Great reasoning)
# - qwen/qwen2.5-72b-instruct (Top-tier coding & technical writing)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------
# OPTION 2: Google Gemini (Alternative)
# Get free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# OPTION 3: OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
